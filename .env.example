# Required for admin-managed upstream credentials: exactly 32 random bytes,
# encoded as 43 unpadded base64url characters. Keep it stable and secret.
UPSTREAM_CREDENTIALS_ENCRYPTION_KEY=
# Comma-separated exact HTTPS origins that administrators may select when
# saving a runtime data source. Store this value as a hosting Secret. An empty
# allowlist keeps upstream validation, synchronization and proxying closed.
UPSTREAM_ALLOWED_ORIGINS=
RESELLER_AUTHORIZED=false

# Stablecoin checkout provider.
PAYMENT_PROVIDER=nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
CRYPTO_PAYMENTS_ENABLED=false
# Set true only after the upstream Provider confirms the payment model in
# writing and the evidence is archived privately.
UPSTREAM_COMMERCIAL_CLEARANCE_CONFIRMED=false
LEGAL_REVIEW_CONFIRMED=false

# Optional x402 v2 Agent batch settlement. This is separate from prepaid
# balance/API Key billing. The caller/Agent owns its wallet and private key;
# RelayBase only authenticates its own facilitator requests.
X402_ENABLED=false
X402_PAY_TO_ADDRESS=
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# CDP Secret API Key credentials used by this resource server to call the
# facilitator. CDP_API_KEY_SECRET must be a 64-byte Ed25519 secret encoded as
# base64. It is not a caller wallet private key.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# For a private non-CDP facilitator, use a server-side bearer token. The
# unauthenticated option is only for an isolated local test facilitator.
X402_FACILITATOR_BEARER_TOKEN=
X402_FACILITATOR_ALLOW_UNAUTHENTICATED=false
X402_FACILITATOR_TIMEOUT_MS=15000

# Required canonical public origin, for OAuth, payment callbacks and redirects.
# Production must use the exact HTTPS origin with no path/query.
PUBLIC_APP_URL=

# Customer authentication. Production readiness requires both Google and
# wallet login; trusted Sites identity headers are preview-only fallback.
# Google callback: ${PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WALLET_LOGIN_ENABLED=false
AUTH_SESSION_TTL_DAYS=30

# Only enable behind a hosting edge that strips client-supplied
# oai-authenticated-user-* headers and injects authenticated values itself.
TRUST_SITES_IDENTITY_HEADERS=false

# Optional operational tuning.
API_RATE_LIMIT_RPM=60
UPSTREAM_RATE_LIMIT_RPS=8
ACCOUNT_CONCURRENCY_LIMIT=5
UPSTREAM_TIMEOUT_MS=45000
UPSTREAM_MAX_RESPONSE_BYTES=8388608
PAYMENT_CREATE_LIMIT_PER_MINUTE=3
PAYMENT_PROVIDER_LIMIT_PER_MINUTE=60

# Admin operations. ADMIN_MASTER_SECRET opens the complete admin console;
# scoped secrets can be used by isolated schedulers/workflows.
CATALOG_SYNC_SECRET=
RECONCILIATION_SECRET=
PAYMENT_ADMIN_SECRET=
ADMIN_MASTER_SECRET=
PRICE_MARKUP_BPS=3000
